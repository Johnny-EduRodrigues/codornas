@startuml
skinparam classAttributeIconSize 0
hide circle

class Tenant {
  +id: Integer
  +name: String
  +categories: List<Category>
}

class User {
  +id: Integer
  +name: String
  +email: String
  +created_at: DateTime
  +password: String
  +obs: Text
  +tenant_id: Integer
  +super_admin: Boolean
  +artifacts_admin: List<Artifact>
  +reservations_observer: List<Reservation>
}

class Reservation {
  +id: Integer
  +user_id: Integer
  +artifact_id: Integer
  +date: Date
  +start_time: Time
  +end_time: Time
  +purpose_id: Integer
  +active: Boolean
  +batch_id: UUID
  +obs: Text
  +created_at: DateTime
  +canceler_user_id: Integer
  +canceler_annotation: Text
  +tenant_id: Integer
  +group_id: Integer
  +user: User
  +artifact: Artifact
  +purpose: Purpose
  +canceler_user: User
  +tenant: Tenant
  +group: Group
  +observers: List<User>
}

class Artifact {
  +id: Integer
  +name: String
  +created_at: DateTime
  +tenant_id: Integer
  +categories: List<Category>
  +admins: List<User>
}

class Purpose {
  +id: Integer
  +description: String
  +created_at: DateTime
  +tenant_id: Integer
}

class Group {
  +id: Integer
  +acronym: String
  +name: String
  +active: Boolean
  +obs: Text
  +created_at: DateTime
  +color: String
  +tenant_id: Integer
}

class Category {
  +id: Integer
  +name: String
  +color: String
  +tenant_id: Integer
  +created_at: DateTime
  +artifacts: List<Artifact>
}

Tenant "1" -- "0..*" Category
Tenant "1" -- "0..*" User
Tenant "1" -- "0..*" Artifact
Tenant "1" -- "0..*" Purpose
Tenant "1" -- "0..*" Reservation
Tenant "1" -- "0..*" Group

User "1" -- "0..*" Reservation : creates
User "1" -- "0..*" Reservation : cancels
User "0..*" -- "0..*" Artifact : administers
User "0..*" -- "0..*" Reservation : observes

Artifact "1" -- "0..*" Reservation
Artifact "0..*" -- "0..*" Category

Purpose "1" -- "0..*" Reservation
Group "1" -- "0..*" Reservation

@enduml
